<Project>

  <!--
    Makes the code style rules in .editorconfig show up in `dotnet build` and in CI, not only in
    an IDE with the solution open. They are all warnings by design — this reports, it does not
    gate. See the header of .editorconfig for why.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!--
    One version for the whole platform, taken from the git tag.

    The server image, the auth image, and the Helm chart are released together from a `v1.2.0`
    tag, because they are one deployable thing: a console that talks to an auth service whose
    token claims the server validates is not a set of independently versionable parts. Client
    libraries are the exception and version on their own, against a documented minimum server
    version — an SDK churns on a different clock than the platform it talks to.

    Untagged builds get MinVer's default height-based prerelease version, which is what makes a
    local build obviously not a release.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>alpha.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
