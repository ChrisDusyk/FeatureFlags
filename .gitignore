# .NET
bin/
obj/
*.user
.vs/

# The JavaScript SDK builds its generated props path with a hardcoded Windows separator
# ($(IntermediateOutputPath)\package.g.props in Sdk.targets), so on Linux and macOS it can
# land as a directory literally named "obj\Debug" that the obj/ rule above never matches.
# Current builds normalize it; this catches the case where they do not.
obj\\Debug/

# Aspire
**/obj/.aspire/

# Node
#
# Unanchored, so they match at any depth. These were once scoped to frontend/, which held for as
# long as frontend/ was the only JavaScript in the tree — auth/ and clients/node/ each carry their
# own .gitignore, and a directory is only covered from the commit that adds one. Checking out a
# branch from before that commit leaves the build output on disk with nothing ignoring it, which is
# how 3,900 files of node_modules once landed in a commit about SDK keys.
node_modules/
dist/
*.log
npm-debug.log*
pnpm-debug.log*

# Editors / OS
.vscode/*
!.vscode/mcp.json
.idea/
.DS_Store

# Claude Code local (personal) settings
.claude/settings.local.json

# User secrets / local config
appsettings.*.local.json

# A deployment's real configuration: the auth secret and the database password live here.
# .env.example is the committed one.
deploy/compose/.env

# The OpenAPI document is generated on demand (-p:OpenApiGenerateDocumentsOnBuild=true) and
# published as a release asset, so a copy in the tree would only ever be a stale one.
openapi/
